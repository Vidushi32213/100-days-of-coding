#include <stdio.h>

int main() {
    int n, x;
    int leftSum = 0, rightSum;

    printf("Enter n: ");
    scanf("%d", &n);

    for (x = 1; x <= n; x++) {
        leftSum = leftSum + x;

        rightSum = 0;

        for (int i = x; i <= n; i++) {
            rightSum = rightSum + i;
        }

        if (leftSum == rightSum) {
            printf("%d", x);
            return 0;
        }
    }

    printf("-1");

    return 0;
}
