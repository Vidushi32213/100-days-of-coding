#include <stdio.h>
#include <string.h>

int main() {
    char s[100];
    int i, j, k;
    int maxLength = 0;
    int length;
    int repeat;

    printf("Enter string: ");
    scanf("%s", s);

    for(i = 0; s[i] != '\0'; i++) {

        length = 0;

        for(j = i; s[j] != '\0'; j++) {

            repeat = 0;

            for(k = i; k < j; k++) {
                if(s[k] == s[j]) {
                    repeat = 1;
                    break;
                }
            }

            if(repeat)
                break;

            length++;
        }

        if(length > maxLength)
            maxLength = length;
    }

    printf("%d", maxLength);

    return 0;
}
