#include <stdio.h>

int main() {
    int a[100], n, x;
    int i, index = -1;

    printf("Enter size: ");
    scanf("%d", &n);

    printf("Enter sorted elements: ");

    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter x: ");
    scanf("%d", &x);

    for (i = 0; i < n; i++) {

        if (a[i] >= x) {
            index = i;
            break;
        }
    }

    printf("%d", index);

    return 0;
}
